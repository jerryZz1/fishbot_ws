<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    mybot_ultrasonic:
    - 创建一个超声 frame（link），并固定到 parent
    - 仅用于 TF / 可视化；不影响你当前避障节点订阅 Range 话题
  -->
  <xacro:macro name="mybot_ultrasonic" params="name parent xyz rpy">

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- 占位：小盒子 -->
          <box size="0.03 0.02 0.02"/>
        </geometry>
        <material name="orange">
          <color rgba="1.0 0.5 0.0 0.8"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>
